{
    // =========================================================================
    // BACKEND SELECTION (which AI to use)
    // =========================================================================
    // The plugin auto-detects the backend from what you configure below:
    //   - If "openai_base_url" is set     → uses Ollama / OpenAI-compatible
    //   - If "deepseek_api_key" is set    → uses DeepSeek
    //   - Otherwise                       → uses Claude / Kimi (default)
    //
    // You can also force a backend explicitly:
    // "default_backend": "claude",   // Options: "claude", "openai", "deepseek", "codex"

    // =========================================================================
    // CLAUDE / KIMI BACKEND (default — uses the official `claude` CLI)
    // =========================================================================
    // These override ~/.claude/settings.json for the Sublime plugin only.
    // If left empty, the plugin uses your global `claude` CLI configuration.
    //
    // Path to the `claude` CLI binary. Leave as "claude" to use PATH, or set
    // an absolute path (e.g. "/Users/you/.local/bin/claude") if Sublime can't find it.
    // "claude_cli_path": "claude",
    //
    // Point base_url at any Anthropic-compatible provider (Kimi, a gateway,
    // a proxy) and the claude backend talks to it instead of Anthropic.
    // "anthropic_base_url": "https://api.kimi.com/coding/",
    // "anthropic_api_key": "sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    //
    // Legacy alias for "default_model", honoured only by the claude backend.
    // Prefer "default_model" (or "default_models") below.
    // "anthropic_model": "kimi-for-coding",
    //
    // NOTE: a provider that speaks the Anthropic API echoes back whatever
    // model name you send and is fed Claude Code's own system prompt, so both
    // the status bar and the model's own answer to "which model are you?"
    // report that name — they are not proof of who served the request.

    // =========================================================================
    // OLLAMA / OPENAI-COMPATIBLE BACKEND (local or remote)
    // =========================================================================
    // Set these to switch to a local Ollama server or any OpenAI-compatible API.
    // When these are set, "Claude: New Session" will use this backend instead.
    //
    // "openai_base_url": "http://localhost:11434",
    // "openai_api_key": "",              // Optional for local Ollama
    // "openai_model": "qwen2.5:7b",

    // =========================================================================
    // DEEPSEEK BACKEND
    // =========================================================================
    // "deepseek_api_key": "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",

    // =========================================================================
    // GENERAL PLUGIN SETTINGS
    // =========================================================================

    // Path to Python 3.10+ interpreter for the bridge process.
    // Leave as "python3" to auto-detect, or set an explicit path.
    "python_path": "python3",

    // Whether to offer to install the LSP package and a language server when
    // they are missing. "ask" prompts once per start until answered; "never"
    // stays quiet. The lsp tools need both — LSP alone has no server.
    "lsp_install_prompt": "ask",

    // Which model a new session asks for, when no profile is selected.
    // Precedence, most specific first:
    //     default_models[backend]  >  default_model  >  built-in fallback
    // Switch the running session instead with "Claude: Select Model", or
    // persist a choice with "Claude: Set Default Model".
    // "default_model": "kimi-for-coding",

    // Tools the AI is allowed to use
    "allowed_tools": ["Read", "Write", "Edit", "Bash", "Glob", "Grep", "WebFetch", "WebSearch"],

    // Permission mode for tool execution
    // Options: "default", "acceptEdits", "plan", "bypassPermissions"
    "permission_mode": "acceptEdits",

    // Reasoning effort level: "low", "high", "max"
    "effort": "high",

    // Persona service URL for identity management
    "persona_url": "http://localhost:5002/personas",

    // Extra CLI arguments passed to `claude` (e.g. "--max-budget-usd 5 --verbose")
    // "claude_extra_args": "",

    // Per-backend model, the most specific setting there is. Wins over
    // "default_model" above.
    // "default_models": {
    //     "claude": "opus",
    //     "openai": "qwen2.5:7b",
    //     "deepseek": "deepseek-v4-pro"
    // },

    // Show AI chat in a side panel (right column) like VS Code
    // When true, splits the window into 2 columns (code left, chat right)
    "claude_side_panel": true,

    // Smart context: auto-add git-modified files, open files, and current scope
    // to context before each query
    "smart_context_enabled": true,

    // Auto-add current file to context when querying without explicit context
    "auto_add_current_file": true,

    // Auto-compact context when it exceeds this percentage of the model's
    // context window. Set to 0 to disable. Default is 70%.
    "auto_compact_threshold": 70,

    // Environment variables passed to bridge process
    // "env": {},

    // ─── Laravel / PHP ──────────────────────────────────────────────────────

    // How to invoke artisan for @artisan. A dockerised app needs the full
    // command, e.g. "docker compose exec -T app php artisan".
    "artisan_command": "php artisan",

    // Seconds before an artisan call is given up on.
    "artisan_timeout": 20,

    // @quality runs whichever of these the project actually configures
    // (pint.json / phpstan.neon). Set either to false to skip it.
    "php_pint": true,
    "php_phpstan": true,

    // Override the binaries if they are not in vendor/bin or on PATH.
    // "php_pint_command": "docker compose exec -T app ./vendor/bin/pint",
    // "php_phpstan_command": "docker compose exec -T app ./vendor/bin/phpstan",

    // Override the level in phpstan.neon for @quality runs only.
    // "php_phpstan_level": 8,

    // PHP's stock 128M limit makes PHPStan crash mid-analysis and report
    // nothing, which reads as a clean result.
    "php_phpstan_memory_limit": "512M",

    // Seconds before a Pint/PHPStan run is given up on.
    "php_timeout": 120,
}
